{
  "name": "mc-resource-bot",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-20-bullseye",
  "postCreateCommand": "npm install && (test -f .env || cp .env.example .env)",
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint"]
    }
  },
  "remoteEnv": {
    "NODE_ENV": "production"
  }
}
